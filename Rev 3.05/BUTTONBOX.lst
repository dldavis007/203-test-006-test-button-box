 60DC            ; UNSIGNED8 setFilters[8] = {0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80};
 60DC            ; /**************************************************************************
 60DC            ; DOES:    Initializes the next available filter                    
 60DC            ; RETURNS: 0 for failed init, 1 for successful init
 60DC            ;  
 60DC            ; This function replaces the original function that just
 60DC            ; set up to 8 filters, requiring a match of all bits.
 60DC            ; This function can be called as previously with just
 60DC            ; the CANID argument and it will function as it previously
 60DC            ; was intended.
 60DC            ;  
 60DC            ; This function keeps track of all filters that have been set.
 60DC            ; If the address (last 7 bits in CANID as defined by 'bin'
 60DC            ; after applying the mask to the CANID) in a given CANID corresponds
 60DC            ; to a set filter (kept in global variable list setFilters; declared
 60DC            ; in mcohw.c), no filter is set. Otherwise, the filter is set,
 60DC            ; the filter is added to setFilters, gCANFilter is incremented
 60DC            ; and 1 (success) is returned
 60DC            ;  
 60DC            ; The call to this function in "MCO_Init" that sets the filter
 60DC            ; for the NMT master does not need modified, should look like
 60DC            ; the following: ("if (!MCOHW_SetCANFilter(0))")
 60DC            ;  
 60DC            ; The call to this function in "MCO_Init" that sets the filter
 60DC            ; to accept SDO for this node, should look like the following
 60DC            ; (such as; "if (!MCOHW_SetCANFilter(0x600+Node_ID))"
 60DC            ;                  
 60DC            ; The call to this function in "MCO_Init" that sets the filter
 60DC            ; to accept RPDOs for this node, should look like the following
 60DC            ; (such as; "if (!MCOHW_SetCANFilter(gRPDOConfig[PDO_NR].CANID))"
 60DC            ;                  
 60DC            ; **************************************************************************/
