{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build-Run GCC",
      "detail": "Compile and run host GCC regression tests; this does not build or upload 9S12 firmware.",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/tests/run_regression.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Build 9S12 GCC",
      "detail": "Build complete embedded firmware (GNU68HC12 required).",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/build_9s12.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build + Load NoICE",
      "detail": "Build firmware, then open NoICE and load the fresh ELF. Target stays halted until Run.",
      "type": "shell",
      "command": "${workspaceFolder}\\build_and_debug_noice.bat",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
